    "Alles bereit." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All set."
          }
        }
      }
    },
    "Alles bleibt auf diesem Mac, verschlüsselt mit einem Schlüssel aus deinem Schlüsselbund." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything stays on this Mac, encrypted with a key from your keychain."
          }
        }
      }
    },
    "Alles bleibt verschlüsselt auf diesem Mac. CopyPal sammelt keine Nutzungsdaten und geht nur für Updates und Website-Symbole ins Netz – beides nur mit deiner Zustimmung." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything stays encrypted on this Mac. CopyPal collects no usage data and only goes online for updates and website icons – both only with your consent."
          }
        }
      }
    },
    "Alles bleibt verschlüsselt auf diesem Mac. Sensible Einträge sind verdeckt und verschwinden nach kurzer Zeit." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything stays encrypted on this Mac. Sensitive entries are hidden and disappear after a short time."
          }
        }
      }
    },
