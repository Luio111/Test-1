// Shared build settings for all configurations. Personal values (team, bundle ID
// prefix) live in Signing.local.xcconfig, which is not checked in.

MACOSX_DEPLOYMENT_TARGET = 14.0
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// Fallback prefix; override in Signing.local.xcconfig with an ID that is unique to you.
BUNDLE_ID_PREFIX = io.github.luio111
DEVELOPMENT_TEAM =

// Stable development signing keeps the Accessibility grant across rebuilds.
// Never switch to "Sign to Run Locally" (ad hoc), see Docs/Troubleshooting.md.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development
ENABLE_HARDENED_RUNTIME = YES

// App target: Swift 5 mode with complete concurrency checking, see Docs/ADR/0002.
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = complete

// Info.plist is generated from these keys, merged with Config/Info.plist (Sparkle keys).
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Config/Info.plist
INFOPLIST_KEY_LSUIElement = YES
INFOPLIST_KEY_NSPrincipalClass = NSApplication
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
INFOPLIST_KEY_NSHumanReadableCopyright =

// All UI strings are localizable (LocalizedStringKey / String(localized:)). German is
// the source, English lives in App/Resources/Localizable.xcstrings (ROADMAP D9);
// scripts/check-localization.py fails CI when a text has no translation.
// The compiler does not extract strings: otherwise Xcode rewrites the catalog after
// every build (in a different order per Xcode version) and `git pull` stops on it.
// The script above does the extraction instead.
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
SWIFT_EMIT_LOC_STRINGS = NO
DEAD_CODE_STRIPPING = YES

#include? "Signing.local.xcconfig"

// Sparkle updates (ROADMAP M9): appcast URL and EdDSA public key. Set in
// Release.xcconfig once the key exists (see Docs/Release.md); empty = no updater.
COPYPAL_FEED_URL =
COPYPAL_SPARKLE_PUBLIC_KEY =
